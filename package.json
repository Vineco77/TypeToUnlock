{
  "name": "type-to-unlock",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev": "concurrently -n web,api -c blue,green \"npm:start\" \"npm:dev:server\"",
    "dev:server": "tsx watch server/index.ts",
    "test:server": "tsx --test server/analyze.test.ts server/dictionary.test.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "e2e": "playwright test",
    "test:all": "ng test --watch=false --browsers=ChromeHeadless && npm run test:server && npm run e2e",
    "serve:ssr:type-to-unlock": "node dist/type-to-unlock/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.1",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.1",
    "compromise": "^14.18.0",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.1",
    "@angular/cli": "^19.2.1",
    "@angular/compiler-cli": "^19.2.0",
    "@playwright/test": "^1.64.0",
    "@types/express": "^4.17.17",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  }
}
